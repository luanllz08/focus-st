# ============================================
# Focus STT — Variáveis de Ambiente (SQLite)
# Copie este arquivo para .env e preencha
# ============================================

# Porta do servidor (padrão: 3000)
PORT=3000

# Ambiente: development ou production
NODE_ENV=development

# Chave secreta para JWT (mínimo 256 bits, gere com crypto.randomBytes)
JWT_SECRET=CHANGE_ME_GENERE_UMA_CHAVE_SEGURA_AQUI_MINIMO_32_BYTES

# Expiração do JWT em segundos (padrão: 3600 = 1 hora)
JWT_EXPIRATION=3600

# Fator de custo do bcrypt (padrão: 12)
BCRYPT_ROUNDS=12

# Banco de Dados SQLite
DB_FILE=./database/focus_stt.db

# CORS Origin
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ATENDIMENTO_MAX=5
